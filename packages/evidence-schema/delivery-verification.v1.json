  },
  "lifecycle_states": [
    "CREATED",
    "AWAITING_SELLER_SHIP",
    "AWAITING_LOGISTICS_INTAKE",
    "IN_TRANSIT",
    "AWAITING_LOGISTICS_DELIVER",
    "AWAITING_BUYER_RECEIPT",
    "BUYER_CONFIRMED",
    "BUYER_SILENT_DEFAULT",
    "VERIFIED",
    "REJECTED",
    "WRONG_ITEM",
    "DISPUTED",
    "FAILED"
  ],
  "api": [
    "GET /v1/standards/delivery-verification",
    "GET /v1/standards/delivery-verification/scenes/{scene_id}",
