    "POST /v1/delivery-verification/{id}/logistics-intake",
    "POST /v1/delivery-verification/{id}/capture-challenge",
    "POST /v1/delivery-verification/{id}/proofs",
    "POST /v1/delivery-verification/{id}/logistics-deliver",
    "POST /v1/delivery-verification/{id}/buyer-confirm",
    "POST /v1/delivery-verification/expire-silent-buyers",
    "GET /v1/delivery-verification/{id}"
  ],
  "related_standards": [
