{
  "schema_version": "karma-settlement-reputation-v1",
  "title": "Karma Settlement & Reputation Standard (P8)",
  "title_zh": "Karma 结算信誉标准（P8）",
  "description_zh": "按行业差异化真实结算流程；Agent 在验真通过后智能代验以节省用户时间。结算结果对公「可核验」——公开承诺哈希 + 加密密文可查，禁止明文 PII 公开展示。满足监管审计回溯，同时绝对保护用户隐私。",
  "design_goals_zh": [
    "分场景结算：外卖即时、B2B 发票窗、金融延迟显式确认",
    "Agent 智能验证：P7 VERIFIED + 策略允许时代用户完成验收，减少打扰",
    "公开透明但不明文：outcome_commitment / scope_hash 公开；明细仅 karma2 密文",
    "监管可审计：regulator 角色密钥可解密审计包；公开侧只有承诺",
    "信誉可回溯：场景化信誉增量写入证明，发现排序可消费",
    "与 P4/P6/P7 门闩对齐：确认、违约责任武装、交付验真"
  ],
  "public_attestation": {
    "envelope": "karma2.",
    "kdf": "HKDF-SHA256 domain settle|v1|attestation_id|role",
    "aad": "attestation_id|task_id|scene_id|scope_hash|outcome",
    "public_fields": [
      "attestation_id",
      "task_id_commitment",
      "scene_id",
      "outcome",
      "outcome_commitment",
      "scope_hash",
      "proof_hash",
      "reputation_delta_commitment",
      "settled_at",
      "policy_mode",
      "agent_auto_verified"
    ],
    "private_roles": ["parties", "regulator", "protocol"],
    "note_zh": "任何人可核验承诺是否匹配；只有持角色密钥方可解密明细（买方/卖方/监管）"
  },
  "reputation_profiles": {
    "daily_commerce": {
      "success_base": 3.0,
      "volume_factor": 0.03,
      "dispute_penalty": 10.0,
      "note_zh": "高频小额：小幅加分，争议惩罚适中"
    },
    "b2b": {
      "success_base": 6.0,
      "volume_factor": 0.04,
      "dispute_penalty": 18.0,
      "note_zh": "企业单：履约加分更高，争议更重"
    },
    "professional": {
      "success_base": 5.0,
      "volume_factor": 0.04,
      "dispute_penalty": 15.0,
      "note_zh": "专业服务：中等加分"
    },
    "high_risk": {
      "success_base": 4.0,
      "volume_factor": 0.02,
      "dispute_penalty": 25.0,
      "require_explicit_buyer": true,
      "note_zh": "金融/医疗：强制显式确认，争议重罚"
    },
    "digital": {
      "success_base": 2.0,
      "volume_factor": 0.02,
      "dispute_penalty": 12.0,
      "note_zh": "API/数据：轻量加分"
    }
  },
  "global_defaults": {
    "require_p7_verified": true,
    "require_p6_liability_when_armed": false,
    "require_success_receipt": true,
    "seal_attestation_on_settle": true,
