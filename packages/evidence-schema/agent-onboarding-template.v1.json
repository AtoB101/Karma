{
  "schema_version": "karma-agent-onboarding-v1",
  "title": "Karma Agent Onboarding Template",
  "title_zh": "Karma Agent 自动化接入标准模板",
  "description": "Agents read this template before connect. User profile is minimal; merchant/enterprise pick industry templates so other agents know capabilities without manual field-by-field owner input.",
  "description_zh": "接入前 agent 先读取本模板。用户侧极简；商家/企业按行业模板自动填写能力、服务对象、营业时间与描述，便于其他 agent 发现与协作。",
  "design_goals_zh": [
    "不懂 agent 的主人只需选角色（用户/商家/企业）与行业大类",
    "agent 比主人更清楚自己的能力边界，由 agent 对照模板自填",
    "接入后目录字段标准化，其他 agent 可立即读懂能做什么",
    "与 Important Fields 场景 scene_id 对齐，避免两套标准"
  ],
  "profiles": {
    "user": {
      "profile_id": "user",
      "title_zh": "用户（需求方）",
      "title_en": "User / Buyer",
      "karma_role": "client",
      "selection_burden": "minimal",
      "owner_choices_zh": [
        "确认以用户身份接入（几乎无需其他选择）"
      ],
      "agent_auto_fill": {
        "capabilities": [
          "karma_discover_for_intent",
          "karma_fulfill_intent",
          "important_fields_submit",
          "karma_settle"
        ],
        "default_scenes_interest": [
          "ride_hailing",
          "hotel_booking",
          "food_delivery",
          "flight_booking",
          "api_tool_call"
        ],
        "description_template_zh": "用户侧助手：代为发现 Karma 商家、提交加密重要字段、完成履约与结算；不对外售卖服务。"
      },
      "required_fields": [
        {
          "path": "display_name",
          "type": "string",
          "description_zh": "展示名（可由 agent 生成）"
        },
        {
          "path": "preferred_currency",
          "type": "string",
          "enum": [
            "USDC",
            "USDT",
            "USD",
            "CNY",
            "EUR"
          ],
          "default": "USDC"
        }
      ],
      "optional_fields": [
        {
          "path": "home_region",
          "type": "string",
          "description_zh": "常用地区"
        },
        {
          "path": "language",
          "type": "string",
          "default": "zh-CN"
        },
        {
          "path": "endpoint_url",
          "type": "string",
          "description_zh": "可选 A2A/MCP 回调"
        }
      ]
    },
    "merchant": {
      "profile_id": "merchant",
      "title_zh": "商家（服务方）",
      "title_en": "Merchant / Seller",
      "karma_role": "worker",
      "selection_burden": "template_guided",
      "owner_choices_zh": [
        "选择商家身份",
        "选择 1+ 个行业/场景模板（或让 agent 自选匹配项）"
      ],
      "agent_auto_fill": {
        "always_capabilities": [
          "karma_settle",
          "important_fields_submit",
          "a2a_negotiate"
        ],
        "description_template_zh": "{display_name}：{industry_titles}服务商。服务对象：{service_targets}。营业时间：{business_hours}。能力：{capability_summary}。边界：{boundaries}。"
      },
      "required_fields": [
        {
          "path": "display_name",
          "type": "string",
          "description_zh": "商家/店铺名"
        },
        {
          "path": "industry_ids",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description_zh": "行业模板 id（= scene_id）"
        },
        {
          "path": "service_targets",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "consumer",
              "business",
              "agent"
            ]
          },
          "description_zh": "服务对象"
        },
        {
          "path": "business_hours",
          "type": "object",
          "description_zh": "营业时间",
          "properties": {
            "timezone": {
              "type": "string"
            },
            "weekly": {
              "type": "string"
            },
            "24_7": {
              "type": "boolean"
            }
          }
        },
        {
          "path": "service_area",
          "type": "object",
          "description_zh": "服务范围",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "digital",
                "physical",
                "hybrid"
              ]
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "geo_notes": {
              "type": "string"
            }
          }
        },
        {
          "path": "capability_summary",
          "type": "string",
          "description_zh": "能力摘要（agent 自写）"
        },
        {
          "path": "boundaries",
          "type": "string",
          "description_zh": "不做/边界（agent 自写）"
        }
      ],
      "optional_fields": [
        {
          "path": "endpoint_url",
          "type": "string"
        },
        {
          "path": "avg_ticket_amount",
          "type": "string"
        },
        {
          "path": "languages",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "path": "verification_preference",
          "type": "string",
          "enum": [
            "auto",
            "buyer_confirm",
            "external_verifier"
          ]
        }
      ]
    },
    "enterprise": {
      "profile_id": "enterprise",
      "title_zh": "企业（组织侧）",
      "title_en": "Enterprise",
      "karma_role": "worker",
      "selection_burden": "template_guided",
      "owner_choices_zh": [
        "选择企业身份",
        "选择企业类型与行业模板",
        "声明主要是采购方、供应方或双边"
      ],
      "agent_auto_fill": {
        "always_capabilities": [
          "karma_settle",
          "important_fields_submit",
          "a2a_negotiate",
          "b2b_ready"
        ],
        "description_template_zh": "{display_name}（{enterprise_type}）：面向{service_targets}，场景{industry_titles}。组织能力：{capability_summary}。合规边界：{boundaries}。服务时间：{business_hours}。"
      },
      "required_fields": [
        {
          "path": "display_name",
          "type": "string"
        },
        {
          "path": "enterprise_type",
          "type": "string",
          "enum": [
            "supplier",
            "buyer_org",
            "platform",
            "api_provider",
            "integrator",
            "manufacturer",
            "logistics_operator",
            "other"
          ]
        },
        {
          "path": "trade_side",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sell",
              "buy"
            ]
          }
        },
        {
          "path": "industry_ids",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        {
          "path": "service_targets",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "consumer",
              "business",
              "agent"
            ]
          }
        },
        {
          "path": "business_hours",
          "type": "object"
        },
        {
          "path": "service_area",
          "type": "object"
        },
        {
          "path": "capability_summary",
          "type": "string"
        },
        {
          "path": "boundaries",
          "type": "string"
        },
        {
          "path": "compliance_flags",
          "type": "object",
          "properties": {
            "no_fund_custody": {
              "type": "boolean"
            },
            "non_clinical_only": {
              "type": "boolean"
            },
            "data_residency": {
              "type": "string"
            }
          }
        }
      ],
      "optional_fields": [
        {
          "path": "endpoint_url",
          "type": "string"
        },
        {
          "path": "org_id",
          "type": "string"
        },
        {
          "path": "invoice_currency",
          "type": "string",
          "enum": [
            "USDC",
            "USDT",
            "USD",
            "CNY",
            "EUR"
          ]
        }
      ]
    }
  },
