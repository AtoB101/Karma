    "output": {
      "agent_connect": [
        "agent_id?",
        "name",
        "role",
        "endpoint_url?",
        "capabilities"
      ],
      "profile_card": [
        "profile_id",
        "industry_ids",
        "service_targets",
        "business_hours",
        "service_area",
        "description",
        "boundaries",
        "compliance_flags?"
      ],
      "discovery_hints": [
        "scene_ids",
        "group_tags",
        "risk_tiers"
      ]
    },
    "rules_zh": [
      "capabilities = 模板 always_capabilities ∪ 各 industry suggested_capabilities ∪ agent 自报额外能力",
      "description 用 profile description_template_zh 渲染，禁止空描述接入商家/企业",
      "user 不要求 industry_ids",
      "含 financial_services 则 compliance_flags.no_fund_custody 必须为 true",
      "含 healthcare_medical 则 compliance_flags.non_clinical_only 必须为 true"
    ]
  },
  "agent_read_apis": [
    "GET /v1/standards/onboarding",
    "GET /v1/standards/onboarding/profiles",
    "GET /v1/standards/onboarding/profiles/{profile_id}",
    "GET /v1/standards/onboarding/industries",
    "GET /v1/standards/onboarding/industries/{industry_id}",
    "POST /v1/standards/onboarding/materialize",
    "POST /v1/agents/connect-from-template"
  ],
  "recommended_agent_flow_zh": [
    "1. 主人说：接入 Karma，我是商家/用户/企业",
    "2. agent GET /v1/standards/onboarding 读取标准",
    "3. agent 按自身能力匹配 industries，生成 answers",
    "4. POST materialize 得到标准化 connect 载荷与描述",
    "5. POST /v1/agents/connect-from-template 一键接入",
    "6. 其他 agent 通过 discovery 读取 capabilities + profile_card 即可协作"
  ]
}
