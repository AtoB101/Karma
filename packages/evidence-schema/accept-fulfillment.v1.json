{
  "schema_version": "karma-accept-fulfillment-v1",
  "title": "Karma Accept & Fulfillment Standard (P6)",
  "title_zh": "Karma 接单履约标准（P6）",
  "description_zh": "卖方确认接单有时限；超时自动取消并记入未确认记录。多次超时/拒接提升验证档与违约责任金；卖方确认后即武装违约赔偿责任。信誉仅小幅下调，避免一票否决，但可影响发现排序。",
  "design_goals_zh": [
    "真实场景：外卖/叫车短时限；酒店/机票中时限；B2B/专业服务长时限",
    "超时自动取消，避免买家干等；可重新发现匹配",
    "长期多次未确认 → 更强验证 + 更高违约责任金 + 轻微信誉扣分",
    "确认接单后违约责任生效，对照已锁定 Important Fields 履约",
    "高风险场景（金融/医疗）禁止软超时绕过，责任金更高"
  ],
  "global_defaults": {
    "seller_accept_ttl_seconds": 1800,
    "on_timeout": "cancel_intent",
    "reputation_delta_on_timeout": -2.0,
    "reputation_delta_on_reject": -3.0,
    "max_reputation_hit_per_event": 5.0,
    "non_confirm_thresholds": [
      {
        "count": 3,
        "verification_tier": "elevated",
        "bond_multiplier": 1.5,
        "force_owner_confirm": true,
        "ttl_scale": 0.75,
        "note_zh": "三次未确认：强制人工确认、责任金×1.5"
      },
      {
        "count": 7,
        "verification_tier": "strict",
        "bond_multiplier": 2.5,
        "force_owner_confirm": true,
        "ttl_scale": 0.5,
        "note_zh": "七次未确认：严格验证、责任金×2.5、更短接单窗"
      },
      {
        "count": 15,
        "verification_tier": "restricted",
        "bond_multiplier": 4.0,
        "force_owner_confirm": true,
        "ttl_scale": 0.35,
        "discovery_demote": true,
        "note_zh": "十五次未确认：限制档、责任金×4、发现排序明显靠后"
      }
    ],
    "post_confirm_breach": {
      "liability_armed": true,
      "base_bond_bps": 500,
      "compensation_bps_of_amount": 1000,
      "cure_period_seconds": 0,
      "note_zh": "确认接单后即武装违约责任；补偿默认订单金额 10%"
    },
    "verification_tiers": {
      "normal": {"rank": 3, "title_zh": "常规"},
      "elevated": {"rank": 2, "title_zh": "加强验证"},
      "strict": {"rank": 1, "title_zh": "严格验证"},
      "restricted": {"rank": 0, "title_zh": "限制接单"}
    }
  },
