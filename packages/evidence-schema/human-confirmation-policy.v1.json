{
  "schema_version": "karma-human-confirmation-v1",
  "title": "Karma Human Confirmation Policy",
  "title_zh": "Karma 人工确认策略（现实场景分流）",
  "description_zh": "把链路拆成：可自动执行 vs 必须主人确认。Agent 只在必须确认点向主人询问「是否确认」；确认后即可接单/执行。",
  "design_goals_zh": [
    "符合叫车/外卖/酒店/机票/采购等现实习惯：钱、身份、不可逆承诺要人确认；匹配、出票执行、轨迹回传可自动",
    "提高效率：主人不必逐步点流程，只需在关键门闩上 Yes/No",
    "与 Important Fields 三方锁定、onboarding service_specs、settlement 对齐"
  ],
  "gate_modes": {
    "AUTO": "协议/Agent 可直接执行，无需打扰主人",
    "OWNER_CONFIRM": "必须主人明确确认（Yes）后才能继续；Agent 只问是否确认",
    "POLICY_AUTO": "若 automation-policy / 预授权满足则可自动，否则降级为 OWNER_CONFIRM",
    "COUNTERPARTY_OR_OWNER": "对端确认或主人确认其一即可（场景相关）"
  },
  "lifecycle_steps": [
    "onboarding_publish",
    "discover",
    "select_offer",
    "lock_important_fields",
    "accept_order",
    "execute_service",
    "submit_delivery_proof",
    "buyer_accept_settle",
    "cancel",
    "dispute_or_refund",
    "price_change_or_surge"
  ],
  "global_defaults": {
    "buyer": {
      "discover": "AUTO",
      "select_offer": "OWNER_CONFIRM",
      "lock_important_fields": "OWNER_CONFIRM",
      "accept_order": "OWNER_CONFIRM",
      "execute_service": "AUTO",
      "submit_delivery_proof": "AUTO",
      "buyer_accept_settle": "OWNER_CONFIRM",
      "cancel": "OWNER_CONFIRM",
      "dispute_or_refund": "OWNER_CONFIRM",
      "price_change_or_surge": "OWNER_CONFIRM"
    },
    "seller": {
