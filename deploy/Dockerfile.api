FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --no-cache-dir poetry && \
    poetry config virtualenvs.create false && \
    poetry install --no-dev --no-interaction

COPY . .

RUN adduser --disabled-password --gecos "" karma && \
    chown -R karma:karma /app
USER karma

EXPOSE 8000

# 单 worker 是硬要求，不是省内存（说明见 deploy/docker-compose.yml 与
# tests/unit/test_single_worker_pinning.py）：刹车/运维暂停、nonce 同进程去重、
# 链上回查冷却表都还是进程内状态；1.6 GB 的机器上 4 份解释器本身就是 OOM 风险。
CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
