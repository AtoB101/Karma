# Docker testnet stack (copy to deploy/.env when using docker-compose.testnet.yml)
# NOT for production mainnet — Sepolia / invited beta only.

APP_ENV=production
APP_SECRET_KEY=replace-with-32-plus-char-random-secret
AUTH_API_KEYS=ops-admin:replace-me,buyer-demo:replace-me,seller-demo:replace-me
AUTH_ENFORCE_PROTECTED_ROUTES=true
AUTH_ALLOW_DEV_KEY_FALLBACK=false
RATE_LIMIT_REDIS_FAIL_CLOSED=true

# MinIO / S3 object store — production validator requires non-default credentials.
# Replace the placeholders with real values and point MINIO_ENDPOINT at a reachable store.
MINIO_ENDPOINT=replace-with-minio-host:9000
MINIO_ACCESS_KEY=replace-with-random-access-key
MINIO_SECRET_KEY=replace-with-random-secret-key
MINIO_SECURE=false
MINIO_BUCKET_EVIDENCE=karma-evidence
MINIO_BUCKET_RECEIPTS=karma-receipts

DATABASE_URL=postgresql+asyncpg://karma:karma@postgres:5432/karma_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4

RECEIPT_REQUIRE_SIGNATURE=true
PROGRESS_REQUIRE_SIGNATURE=true
LEDGER_REQUIRE_PARTY_ACTOR=true
SETTLEMENT_REQUIRE_PARTY_ACTOR=true
RUNTIME_REQUIRE_SAVED_AUTOMATION_POLICY=true
RUNTIME_REQUIRE_TASK_AUTOMATION_READINESS=true
RUNTIME_REQUIRE_HANDOFF_ATTESTATION=true
RUNTIME_REQUIRE_WALLET_IDENTITY_BINDING=true
RUNTIME_DAILY_SPEND_PERSIST=true
TRADE_LAUNCH_REQUIRE_EIP712=true
CHAIN_ALLOW_HOT_WALLET_PAYER=false
OPENCLAW_LOCAL_PHASE1_AUTO_RELAX=false
OPENCLAW_RELAX_DELIVERY_SIGNATURES=false
KARMA_SIGNING_BACKEND=client_only
X402_PAYMENT_BACKEND=sepolia
X402_ENABLED=true

SETTLEMENT_MODE=testnet
TESTNET_CHAIN_ID=84532
TESTNET_RPC_URL=https://sepolia.base.org

# Base Sepolia protocol stack (chain 84532) — public addresses, not secrets.
KARMA_BILATERAL_ADDRESS=0x3D633d55Bb7bDD4Af55a92C0F48dd25B7f06c3A5
ERC20_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
KARMA_REPUTATION_ANCHOR_ADDRESS=0x09e3FEfc653D4Ded3ee12C62A5Ff508673a75dF3
KARMA_VERIFIER_REGISTRY=0xa5f5927D44002F0A8f53984bFD8058eA654E2650
KARMA_EVIDENCE_CHAIN=0x1A34c6e31aD7E2180250c16eEDfaD1485C2286Ff
KARMA_SCORING_ENGINE=0x8c8A6E018fb6F5c48969899aE1335F05E675Ec03
KARMA_CIRCUIT_BREAKER=0x65376016D7f27f82E293cbd0F78DB3b48e0a7b8A
KARMA_EMERGENCY_FREEZE=0x19b4CD0cCCDd25acED81cC1f9C1B7f2d11645fb4
KARMA_IDENTITY_REGISTRY=0xec5B627fD821c6aBF0404e06997D347953eD1333
KARMA_ATTESTATION_GATEWAY=0x330B87AB67cf288F13dA0c4e5e67fF665F4ec15e

ADMIN_ACTOR_IDS=ops-admin
ARBITRATOR_ACTOR_IDS=ops-admin
SECURITY_ONCALL_PRIMARY=oncall-primary@example.com
SECURITY_ONCALL_BACKUP=oncall-backup@example.com

OPENCLAW_WEBHOOK_MAX_RETRIES=3
PAYMENT_INTENT_EXPIRE_ENABLED=true
