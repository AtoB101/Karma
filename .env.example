# Karma — production environment template
# Copy to .env (never commit real values) or set via your host's secrets
# (Fly.io: `fly secrets set ...`; GitHub Actions: Environments → production-fly).
#
# Naming follows repo conventions (services/telegram/bot.py, config/settings.py,
# deploy/one-click-deploy.md). WalletConnect vars are new for the
# Telegram MiniApp + WalletConnect integration.

# ---------------------------------------------------------------------------
# Telegram (Bot + MiniApp)
# ---------------------------------------------------------------------------
# Bot API token from @BotFather (secret)
TELEGRAM_BOT_TOKEN=
# Bot username without @ (used for t.me deep links; non-secret)
TELEGRAM_BOT_USERNAME=KarmaBot
# MiniApp 公网地址：t.me 托管链接或自建静态站 URL（非机密）
# 例: https://t.me/KarmaBot/app 或 https://karma-miniapp.pages.dev
TELEGRAM_MINIAPP_URL=
# Webhook secret_token：Telegram 会在每个 update 的
# X-Telegram-Bot-Api-Secret-Token 头中回传，API 侧 verify_webhook_secret 校验（secret）
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# WalletConnect (MiniApp 钱包连接)
# ---------------------------------------------------------------------------
# 从 https://cloud.walletconnect.com 获取（非机密，但建议保持环境注入）
WC_PROJECT_ID=
# 默认官方 relay；WalletConnect v2 不支持替换自建 bridge，
# 仅在 fork relayer 自托管时覆盖（非机密）
WC_BRIDGE_URL=wss://relay.walletconnect.org
# 前端构建期注入（apps/telegram_miniapp 使用 Vite 风格变量时）
VITE_WC_PROJECT_ID=

# ---------------------------------------------------------------------------
# Contracts / chain
# ---------------------------------------------------------------------------
# RPC endpoint（生产为正式网/testnet 节点，secret 若含 API key）
TESTNET_RPC_URL=
# Chain id（缺省从 RPC 探测）
TESTNET_CHAIN_ID=
# KarmaBilateral 合约地址
KARMA_BILATERAL_ADDRESS=
# 信誉打包锚点（非转账；不减免手续费；达标后记分红权重）
KARMA_REPUTATION_ANCHOR_ADDRESS=
# USDC 代币地址
USDC_ADDRESS=
# 结算模式: offchain | hybrid | testnet
SETTLEMENT_MODE=hybrid

# ---------------------------------------------------------------------------
# v2 非托管授权额度（Allowance Escrow）—— 钱始终留在用户自己的钱包里
# ---------------------------------------------------------------------------
# 开启后操作台「增加锁仓额度」变成「授权额度」（不转账）；结算由用户钱包直接付给收款钱包
CHAIN_ALLOWANCE_ESCROW_ENABLED=false
# KarmaAllowanceEscrow 合约地址
ALLOWANCE_ESCROW_ADDRESS=
# Karma 结算账户（operator）：可代用户 bind/submit，但永远动不了钱
SETTLEMENT_OPERATOR_ADDRESS=
# 结算账户私钥（secret）—— 独立热钱包，绝不放任何用户私钥
SETTLEMENT_OPERATOR_PRIVATE_KEY=
# 付款前的争议窗口秒数（窗口内可 finalizeBreach 罚没卖家质押）
ALLOWANCE_ESCROW_DISPUTE_WINDOW=120
# 算子 gas 价格上限（gwei）；0 = 不限。防止 gas 飙升烧干算子账户
SETTLEMENT_MAX_GAS_PRICE_GWEI=5

# ---------------------------------------------------------------------------
# Infrastructure (Fly.io / Railway)
# ---------------------------------------------------------------------------
# PostgreSQL（async 驱动形式）
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/karma_db
# Redis（Celery broker / cache）
REDIS_URL=redis://default:pass@host:6379/0
# 强随机串，用于签名等（secret）
APP_SECRET_KEY=
# 双 key 平滑轮换（可选）：上一把签发钥 + 过渡期硬截止（ISO8601 UTC，如 2026-11-01T00:00:00Z）。
# 两个都填才进入过渡期；急刹车 = 清空 APP_SECRET_KEY_PREVIOUS。
# APP_SECRET_KEY_PREVIOUS=
# APP_SECRET_KEY_PREVIOUS_UNTIL=
# API-key 鉴权: agent:secret 逗号分隔（secret）
# 每个 service agent 一把独立 key，不要共用 —— 闸门 A4c 会判「密钥不共用 /
# 每把 >= 24 字符 / 管理员·仲裁员·治理白名单里点名的 actor 都有自己的钥匙」。
AUTH_API_KEYS=
# 生产必须为 true
AUTH_ENFORCE_PROTECTED_ROUTES=true
# Console / MiniApp 源，逗号分隔（非机密）
CORS_ALLOW_ORIGINS=

# Evidence 存储（生产用托管 bucket，非机密部分）
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# OpenClaw handoff webhook（可选）
OPENCLAW_WEBHOOK_URL=
OPENCLAW_WEBHOOK_SECRET=

# 平台自举审批白名单：允许走 scripts/maintenance/approve_identity_verification.py
# 的身份，逗号分隔。**默认空 = 谁都不批**，只填平台自有的身份（非机密）
BOOTSTRAP_APPROVE_IDENTITY_IDS=

# 第三方实名 / 活体服务（可选）。默认 none = 不接服务商，主身份认证走复核台人工核验。
# 填了名字但密钥没配齐，接口会明确报缺哪一项，不会静默放行。生产禁止 mock（非机密）
IDENTITY_PROVIDER=none
# 服务商能访问到的公网地址，用来拼回调 URL（非机密）
IDENTITY_PROVIDER_PUBLIC_BASE_URL=
# 回调签名密钥（secret）
IDENTITY_PROVIDER_CALLBACK_SECRET=
# 阿里云实人认证（secret）
IDENTITY_PROVIDER_ALIYUN_ACCESS_KEY_ID=
IDENTITY_PROVIDER_ALIYUN_ACCESS_KEY_SECRET=
IDENTITY_PROVIDER_ALIYUN_SCENE_ID=
# 腾讯云慧眼（secret）
IDENTITY_PROVIDER_TENCENT_SECRET_ID=
IDENTITY_PROVIDER_TENCENT_SECRET_KEY=
IDENTITY_PROVIDER_TENCENT_RULE_ID=
# Persona（海外，secret）
IDENTITY_PROVIDER_PERSONA_API_KEY=
IDENTITY_PROVIDER_PERSONA_TEMPLATE_ID=
IDENTITY_PROVIDER_PERSONA_WEBHOOK_SECRET=

# 生产 runtime 安全开关（APP_ENV=production 时必须全为 true）
RUNTIME_REQUIRE_SAVED_AUTOMATION_POLICY=true
RUNTIME_REQUIRE_TASK_AUTOMATION_READINESS=true
RUNTIME_DAILY_SPEND_PERSIST=true
RUNTIME_REQUIRE_WALLET_IDENTITY_BINDING=true
RUNTIME_REQUIRE_HANDOFF_ATTESTATION=true
# 生产：验证者节点的登记/抵押/见证/挑战写接口必须由节点自己的钱包签名
# （没有签名 = 任何已登录账号都能冒充该节点；测试网要关必须显式设 false）
VERIFIER_REQUIRE_NODE_SIGNATURE=true
# 生产：节点必须声明主人身份，且节点钱包 = 该身份在 Console 绑定的钱包
# （否则任何登录账号都能量产匿名节点，把押金与责任脱钩）
VERIFIER_REQUIRE_OWNER_IDENTITY=true
# 押金必须由已锁仓 USDC 背书（与仲裁 / 治理岗看的是同一本锁仓账）
VERIFIER_REQUIRE_BACKED_BOND=true
# ---------------------------------------------------------------------------
# 生产闸门（APP_ENV=production 时缺一不可：config/settings.py 启动即校验）
# 清单的唯一来源是 config/production_gates.py；新增闸门没同步到这里，CI 会红
# （tests/unit/test_production_gate_manifest_parity.py 逐键校验模板）。
# ---------------------------------------------------------------------------
# 鉴权 / 限流
AUTH_ALLOW_DEV_KEY_FALLBACK=false
RATE_LIMIT_REDIS_FAIL_CLOSED=true
# 回执 / 账本 / 结算：三方 actor 绑定
RECEIPT_REQUIRE_SIGNATURE=true
LEDGER_REQUIRE_PARTY_ACTOR=true
SETTLEMENT_REQUIRE_PARTY_ACTOR=true
# 交易发起（Open Wallet / EIP-712）
TRADE_LAUNCH_REQUIRE_EIP712=true
KARMA_SIGNING_BACKEND=client_only
# x402 支付通道：生产禁止 mock，只能是 env | sepolia
X402_PAYMENT_BACKEND=sepolia
X402_ALLOW_PRIVATE_HOSTS=false
# x402 专用私钥（仅 backend=env|sepolia 需要）：绝不能借用结算运营钱包
X402_PRIVATE_KEY=
# 资金托管：后端热钱包绝不能当托管付款方
CHAIN_ALLOW_HOT_WALLET_PAYER=false
# 争议仲裁员 actor 白名单（非空；fail-closed /disputes/resolve）
ARBITRATOR_ACTOR_IDS=

APP_ENV=production
