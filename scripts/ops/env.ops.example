# Karma — 主机级运维配置。放到 /opt/karma/.env.ops，权限 600。
#
# 这个文件是给**主机上的运维脚本**读的，不是应用读的（应用读 /opt/karma/.env）。
# scripts/ops/backup.sh 和 scripts/ops/security_alert_poller.py 启动时都会读它。
# 改完不用重启任何东西。
#
# 现在这两个出口都还是「没配」状态：
#   * 备份没有离站目的地      -> 快照只落在和数据库同一块盘上（闸门 F5 = HUMAN）
#   * 告警没有真实出口        -> 告警只写进 cron 日志，没人会看到（闸门 G4 = HUMAN）
# 填好下面任意一段，对应闸门项就会从 HUMAN 变成机器可判的 PASS。

# ==========================================================================
# 一、离站备份（scripts/ops/backup.sh）
# ==========================================================================
# none | s3 | rsync | scp
KARMA_BACKUP_OFFSITE=none

# ---- s3（MinIO / 阿里云 OSS / AWS S3 等 S3 兼容端点）----------------------
# 注意：仓库里现在只有 MINIO_ACCESS_KEY / MINIO_SECRET_KEY，**没有端点** ——
# 端点、桶名、前缀要在这里补齐，否则推不出去。
# KARMA_BACKUP_S3_ENDPOINT=https://minio.example.com:9000
# KARMA_BACKUP_S3_BUCKET=karma-backups
# KARMA_BACKUP_S3_PREFIX=karma/testnet
# KARMA_BACKUP_S3_REGION=us-east-1
# KARMA_BACKUP_S3_ACCESS_KEY=
# KARMA_BACKUP_S3_SECRET_KEY=

# ---- rsync / scp 到另一台机器 --------------------------------------------
# KARMA_BACKUP_OFFSITE_TARGET=karma-backup@10.0.0.9:/srv/karma-backups
# 免密：给 root 生成一把 key，把公钥加到目标机的 authorized_keys，再写
#   Host 10.0.0.9  IdentityFile /root/.ssh/karma_backup_ed25519
# 到 /root/.ssh/config。

# KARMA_BACKUP_KEEP=48
# KARMA_BACKUP_SKIP_ENV=1

# ==========================================================================
# 二、安全告警出口（scripts/ops/security_alert_poller.py）
# ==========================================================================
# 轮询与状态
KARMA_ALERT_BASE_URL=http://127.0.0.1:8000
KARMA_ALERT_WINDOW_MINUTES=60
KARMA_ALERT_COOLDOWN_MINUTES=30
# 同一个告警持续存在时，间隔多久再提醒一次（不填 = 6 小时）
KARMA_ALERT_REPEAT_MINUTES=360
KARMA_ALERT_STATE_PATH=/opt/karma/state/security-alerts.json

# 钥匙：不填的话，脚本会去 /opt/karma/.env 的 AUTH_API_KEYS 里找 actor=ops-admin 那把。
# 只有在你想用另一把钥匙时才需要设这一项。
# KARMA_ALERT_API_KEY=

# ---- 出口一：webhook（公司群机器人、自建网关都行）------------------------
# 收到的是 POST 的 JSON：{source, kind, new[], resolved[], escalation, summary, text}
# KARMA_ALERT_WEBHOOK_URL=

# ---- 出口二：Telegram -----------------------------------------------------
# KARMA_ALERT_TELEGRAM_BOT_TOKEN=
# KARMA_ALERT_TELEGRAM_CHAT_ID=

# ---- 出口三：SMTP 邮件 ----------------------------------------------------
# QQ 邮箱要用「授权码」而不是登录密码；发件人和用户名一般填同一个。
# KARMA_ALERT_SMTP_HOST=smtp.qq.com
# KARMA_ALERT_SMTP_PORT=465
# KARMA_ALERT_SMTP_USER=
# KARMA_ALERT_SMTP_PASSWORD=
# KARMA_ALERT_SMTP_FROM=
# KARMA_ALERT_SMTP_TO=haozi8868@qq.com

# ---- 本机体检（不需要外部凭证，装了就有用）-------------------------------
# KARMA_ALERT_BACKUP_ROOT=/opt/karma/backups
# KARMA_ALERT_BACKUP_MAX_AGE_HOURS=26
# KARMA_ALERT_DISK_PATH=/opt/karma
# KARMA_ALERT_DISK_MAX_PERCENT=90